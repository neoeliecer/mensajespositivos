{
    "nodes": [
        {
            "parameters": {},
            "name": "When clicking 'Execute Workflow'",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "filePath": "C:/Users/neo/Documents/agente/mensajes positivos/content_calendar.csv"
            },
            "name": "Read CSV",
            "type": "n8n-nodes-base.readBinaryFile",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "fileFormat": "csv",
                "options": {
                    "headerRow": true
                }
            },
            "name": "Parse CSV",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{$node[\"Parse CSV\"].json[\"Status\"]}}",
                            "value2": "Ready for Video"
                        },
                        {
                            "value1": "={{$node[\"Parse CSV\"].json[\"Video_Path\"]}}",
                            "operation": "isNotEmpty"
                        }
                    ]
                }
            },
            "name": "Filter Ready Posts",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://graph-video.facebook.com/v21.0/me/videos",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "facebookGraphApi",
                "sendBinaryData": true,
                "binaryPropertyName": "video_data",
                "options": {
                    "bodyContentType": "multipart-form-data"
                },
                "bodyParametersUi": {
                    "parameter": [
                        {
                            "name": "description",
                            "value": "={{$node[\"Parse CSV\"].json[\"Facebook_Post_Text\"]}}"
                        },
                        {
                            "name": "title",
                            "value": "={{$node[\"Parse CSV\"].json[\"Title\"]}}"
                        }
                    ]
                }
            },
            "name": "Facebook Video Upload (HTTP)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                1250,
                200
            ],
            "credentials": {
                "facebookGraphApi": {
                    "id": "YOUR_CREDENTIAL_ID_HERE",
                    "name": "Facebook Graph API account"
                }
            }
        },
        {
            "parameters": {
                "filePath": "={{$node[\"Parse CSV\"].json[\"Video_Path\"]}}",
                "binaryPropertyName": "video_data"
            },
            "name": "Read Video File",
            "type": "n8n-nodes-base.readBinaryFile",
            "typeVersion": 1,
            "position": [
                1050,
                200
            ]
        }
    ],
    "connections": {
        "When clicking 'Execute Workflow'": {
            "main": [
                [
                    {
                        "node": "Read CSV",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Read CSV": {
            "main": [
                [
                    {
                        "node": "Parse CSV",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse CSV": {
            "main": [
                [
                    {
                        "node": "Filter Ready Posts",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Ready Posts": {
            "main": [
                [
                    {
                        "node": "Read Video File",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Read Video File": {
            "main": [
                [
                    {
                        "node": "Facebook Video Upload (HTTP)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}