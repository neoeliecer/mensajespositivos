# Clave de API de Groq Cloud (para la automatización diaria a las 8:00 AM)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Clave de API de Google Gemini (para el chat en vivo del Dashboard)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
